---
import { Picture, getImage } from 'astro:assets';
import { photos } from '../scripts/photos';

// Full-size versions for the lightbox (still optimized, EXIF stripped).
const large = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: Math.min(p.src.width, 2000), format: 'webp' })),
);
---
<section class="section gallery on-dark" id="photos" aria-labelledby="photos-title">
  <div class="wrap">
    <div class="section-intro" data-reveal>
      <p class="eyebrow">The engagement photos</p>
      <h2 id="photos-title">A few <em>favorites</em></h2>
      <p>Tap any photo to see it bigger.</p>
    </div>

    <ul class="grid">
      {photos.map((p, i) => (
        <li data-reveal style={`--reveal-delay: ${(i % 3) * 0.1}s`}>
          <button type="button" class="thumb" data-index={i} data-full={large[i].src} data-alt={p.alt}
            aria-label={`Open photo ${i + 1} of ${photos.length}`}>
            <Picture src={p.src} alt={p.alt} formats={['avif', 'webp']} widths={[400, 700, 1000]}
              sizes="(max-width: 600px) 92vw, (max-width: 1000px) 46vw, 30vw" loading="lazy" />
          </button>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <img data-lb-img alt="" />
    <p class="lb-count" data-lb-count></p>
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Close">✕</button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Previous photo">‹</button>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Next photo">›</button>
  </dialog>
</section>

<style>
  .gallery { background: var(--brand); }
  .grid { list-style: none; margin: 0; padding: 0; columns: 3 18rem; column-gap: 1.25rem; }
  .grid li { break-inside: avoid; margin-bottom: 1.25rem; }
  .thumb {
    position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in;
    border-radius: 6px; overflow: hidden;
  }
  .thumb :global(img) { width: 100%; height: auto; transition: transform 1.2s var(--ease-out), filter 0.6s; }
  .thumb::after {
    content: ''; position: absolute; inset: 10px; border: 1px solid var(--grape); border-radius: 3px;
    opacity: 0; transition: opacity 0.5s, inset 0.6s var(--ease-out);
  }
  .thumb:hover :global(img) { transform: scale(1.04); }
  .thumb:hover::after { opacity: 1; inset: 14px; }

  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: transparent; color: var(--on-dark);
  }
  .lightbox[open] { display: grid; place-items: center; animation: fade 0.4s ease; }
  @keyframes fade { from { opacity: 0; } }
  .lightbox::backdrop { background: color-mix(in srgb, var(--brand-deep) 97%, transparent); }
  .lightbox img { max-width: min(92vw, 1400px); max-height: 82dvh; object-fit: contain; border-radius: 4px; }
  .lb-count { position: absolute; bottom: 1.2rem; left: 0; right: 0; text-align: center; margin: 0 auto; font: italic 1.1rem var(--font-display); }
  .lb-btn {
    position: absolute; width: 3rem; height: 3rem; border-radius: 50%;
    border: 1px solid var(--accent); background: transparent; color: var(--accent);
    font-size: 1.6rem; line-height: 1; cursor: pointer; display: grid; place-items: center;
    transition: background 0.3s;
  }
  .lb-btn:hover { background: color-mix(in srgb, var(--accent) 20%, transparent); }
  .lb-close { top: 1rem; right: 1rem; font-size: 1.1rem; }
  .lb-prev { left: 1rem; top: 50%; translate: 0 -50%; }
  .lb-next { right: 1rem; top: 50%; translate: 0 -50%; }
  @media (max-width: 600px) { .lb-prev, .lb-next { top: auto; bottom: 0.6rem; translate: none; } }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.thumb')];
  let current = 0;
  let opener: HTMLElement | null = null;

  function show(i: number) {
    current = (i + thumbs.length) % thumbs.length;
    const t = thumbs[current];
    img.src = t.dataset.full!;
    img.alt = t.dataset.alt!;
    count.textContent = `${current + 1} of ${thumbs.length}`;
    // Preload the neighbours so swiping feels instant
    [current - 1, current + 1].forEach((n) => {
      new Image().src = thumbs[(n + thumbs.length) % thumbs.length].dataset.full!;
    });
  }

  thumbs.forEach((t, i) => t.addEventListener('click', () => { opener = t; show(i); dialog.showModal(); }));
  dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(current + 1));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => opener?.focus());
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // Swipe on phones
  let startX = 0;
  dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
  });
</script>
