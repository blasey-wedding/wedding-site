---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { couple, event } from '../data/wedding';

interface Props { title?: string; description?: string }
const {
  title = `${couple.partnerOne} & ${couple.partnerTwo} | ${event.dateLabel}`,
  description = `Save the date: ${couple.partnerOne} and ${couple.partnerTwo} are getting married on ${event.dateLabel} in ${event.city}.`,
} = Astro.props;

// Use the first engagement photo as the link preview image (texts, iMessage, Facebook).
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const first = Object.keys(photos).sort()[0];
const ogImage = first
  ? await getImage({ src: photos[first].default, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : undefined;
const ogUrl = ogImage ? new URL(ogImage.src, Astro.site).href : undefined;

// Set only when building an archived snapshot (see tools/snapshot.mjs)
const snapshotName = process.env.SNAPSHOT_NAME;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const archivedOn = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4A1019" />
    <meta name="robots" content="noindex, nofollow, noarchive, noimageindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    {snapshotName && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <slot />
    <script>
      // Fade sections up as they scroll into view (see .js [data-reveal] in global.css)
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
    {snapshotName && (
      <p class="archived-badge">Archived design from {archivedOn}</p>
    )}
  </body>
</html>

<style>
  .archived-badge {
    position: fixed; left: 0.75rem; bottom: 0.75rem; z-index: 60; margin: 0;
    font: 600 0.8rem/1 var(--font-display); padding: 0.5rem 0.75rem; border-radius: 999px;
    background: #fff; color: #222; border: 2px solid #222;
  }
</style>
