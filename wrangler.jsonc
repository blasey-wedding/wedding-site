{
  // Cloudflare Workers config. Astro builds the static site into ./dist; the
  // Worker in worker/index.ts handles /api/* (the RSVP and admin APIs).
  "name": "blake-casey-wedding",
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": true,
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wedding-rsvp",
      // Created Nov 10, 2026 with: npx wrangler d1 create wedding-rsvp --location enam
      "database_id": "3237ebab-ed94-40e3-b3d8-ce159db61caf",
      "migrations_dir": "migrations"
    }
  ],
  // Logs from the Worker (including emails logged before Resend is set up)
  "observability": { "enabled": true },
  "vars": {
    // On these hosts the RSVP follows the dates below. Everywhere else
    // (preview URLs, localhost) is test mode: always open.
    "PRODUCTION_HOSTS": "blaseywedding.com,www.blaseywedding.com",
    // PLACEHOLDER dates: set the real ones before invitations go out
    "RSVP_OPENS": "2027-02-01T00:00:00-05:00",
    "RSVP_DEADLINE": "2027-07-24T23:59:59-04:00",
    // Cloudflare's always-pass TEST key. Replace with the real site key at launch.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "EMAIL_FROM": "Blake & Casey <rsvp@blaseywedding.com>",
    "EMAIL_REPLY_TO": "blaseywedding@gmail.com",
    // Filled in once Cloudflare Access protects /admin (see LAUNCH-CHECKLIST.md)
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // Settings for branch previews (Cloudflare runs `wrangler preview` for
  // non-main branches, which requires this block). Previews use their OWN
  // database with sample guests only, so they never touch real guest data.
  // Manage that database with wrangler.preview-db.jsonc.
  "previews": {
    "vars": {
      // Same as above. Preview URLs aren't production hosts, so previews
      // always run in test mode.
      "PRODUCTION_HOSTS": "blaseywedding.com,www.blaseywedding.com",
      "RSVP_OPENS": "2027-02-01T00:00:00-05:00",
      "RSVP_DEADLINE": "2027-07-24T23:59:59-04:00",
      // Previews always use Cloudflare's always-pass TEST key.
      "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
      "EMAIL_FROM": "Blake & Casey <rsvp@blaseywedding.com>",
      "EMAIL_REPLY_TO": "blaseywedding@gmail.com",
      "ACCESS_TEAM_DOMAIN": "",
      "ACCESS_AUD": ""
    },
    "d1_databases": [
      {
        "binding": "DB",
        // wedding-rsvp-preview, created Nov 10, 2026 (sample guests only)
        "database_id": "fef73ccd-d1a5-4f6a-874f-05b19b875402"
      }
    ]
  }
}
