# Copy to .dev.vars for local development:  cp dev.vars.example .dev.vars
# .dev.vars is git-ignored. Production values are set with: npx wrangler secret put NAME

# Any long random string. Generate one with: openssl rand -base64 32
TOKEN_SECRET="local-dev-only-change-me"

# Cloudflare's always-pass TEST secret (pairs with the test site key in wrangler.jsonc)
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"

# Leave empty to log emails to the terminal instead of sending them
RESEND_API_KEY=""

# Lets you open /admin on localhost without Cloudflare Access. Ignored on any other host.
ADMIN_DEV_BYPASS="true"
